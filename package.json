{
  "name": "hubitat-dashboard",
  "version": "0.4.18",
  "private": true,
  "type": "module",
  "description": "Minimal-setup Hubitat dashboard: select your devices and you're done. Room-grouped layout with clean names, installable PWA, fully hosted on your hub.",
  "author": "Ephrayim (evdev)",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/evdev/hubitat-modern-dashboard.git"
  },
  "homepage": "https://github.com/evdev/hubitat-modern-dashboard#readme",
  "scripts": {
    "test": "npm run test:unit",
    "test:unit": "node --test \"test/**/*.test.mjs\"",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-include=src/client/legacy/*.js --test-coverage-include=src/client/domain/*.mjs --test-coverage-include=src/client/runtime/*.mjs --test-coverage-include=src/client/transport/*.mjs --test-coverage-lines=79 --test-coverage-branches=72 --test-coverage-functions=76 \"test/**/*.test.mjs\"",
    "test:contracts": "npm run verify:blobs && npm run verify:blob-crossrefs && npm run verify:post3-boot && npm run verify:auth && npm run verify:pwa && npm run verify:scheduler-source",
    "test:integration": "npm run verify:sensors && npm run verify:favorites && npm run verify:embeds && npm run verify:times && npm run verify:html && npm run verify:schedules && npm run verify:triggers",
    "test:all": "npm run test:unit && npm run test:coverage && npm run build && npm run test:contracts && npm run test:integration",
    "build": "node build.mjs",
    "preview": "node preview/server.mjs",
    "verify:sensors": "node preview/verify-sensors.mjs",
    "verify:favorites": "node preview/verify-favorites-order.mjs",
    "verify:fav-reorder": "node --test test/favorite-reorder.test.mjs",
    "verify:embeds": "node preview/verify-embed-cards.mjs",
    "verify:times": "node preview/verify-time-cards.mjs",
    "verify:html": "node preview/verify-html-tiles.mjs",
    "verify:schedules": "node preview/verify-schedules.mjs",
    "verify:scheduler-naming": "node --test test/scheduler-naming.test.mjs",
    "verify:scheduler-source": "node preview/verify-scheduler-source.mjs",
    "verify:sar-import": "node --test test/sar-import.test.mjs",
    "verify:blobs": "node preview/verify-blob-sizes.mjs",
    "verify:blob-crossrefs": "node preview/verify-blob-crossrefs.mjs",
    "verify:post3-boot": "node preview/verify-post3-boot.mjs",
    "verify:auth": "node preview/verify-dash-auth.mjs",
    "verify:triggers": "node preview/verify-trigger-actions.mjs",
    "verify:pwa": "node preview/verify-pwa-install.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.28.1",
    "fflate": "^0.8.3",
    "happy-dom": "^21.0.1"
  }
}
